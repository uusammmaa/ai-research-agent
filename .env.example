# Copy to .env and fill in values. Never commit .env.

ANTHROPIC_API_KEY=
# Anthropic console: https://console.anthropic.com/

TAVILY_API_KEY=
# Free tier: https://tavily.com/

# ─── Models ──────────────────────────────────────────────────────────────────
# Current Claude models (USD per 1M input/output tokens):
#   claude-opus-5-5     $4 / $20     default: best quality per dollar for multi-step tool use
#   claude-sonnet-5-5   $2 / $10     default fallback; cheaper, still strong at tool use
#   claude-haiku-5-5    $0.10 / $0.50  cheapest; fine for evals judging, weaker at research
#   claude-fable-5-1    $10 / $50    most capable; rarely worth it for this task
MODEL=claude-opus-5-5
# Used when the primary model stays unavailable (429/5xx/529) after retries. Empty disables.
FALLBACK_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max. Higher effort means more thinking tokens per turn.
EFFORT=medium
MAX_TOKENS=16000
# Server-side refusal fallback (beta) on models that support it.
REFUSAL_FALLBACK=true

# ─── Run guards ──────────────────────────────────────────────────────────────
MAX_ITERATIONS=10
MAX_REPAIR_ATTEMPTS=2
RUN_TIMEOUT_SECONDS=300
LLM_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=20
# Attempts include the first try.
LLM_MAX_ATTEMPTS=3
TOOL_MAX_ATTEMPTS=3

# ─── Tracing (OpenTelemetry) ─────────────────────────────────────────────────
# console | console_json | otlp | langfuse | langsmith | none; comma-separate to combine,
# e.g. "console,langfuse".
TRACING_EXPORTER=console
TRACING_SERVICE_NAME=ai-research-agent

# langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# langsmith
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# otlp: the exporter reads the standard OpenTelemetry variables
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=

# Comma-separated browser origins allowed by CORS (e.g. local Next.js + production site)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
